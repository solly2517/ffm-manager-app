# --- Required ---

# MySQL connection string. On Railway, add a "MySQL" database service and
# copy its connection string here (or reference it with ${{MySQL.DATABASE_URL}}
# if you're using Railway's variable references).
DATABASE_URL=mysql://user:password@host:3306/database

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep this secret and never commit it. Rotating it logs everyone out.
JWT_SECRET=

# S3-compatible object storage, used for uploaded photos, signatures, and
# backups. Works with Cloudflare R2, AWS S3, DigitalOcean Spaces, etc.
#
# Cloudflare R2 (recommended - no egress fees):
#   1. Create a bucket at https://dash.cloudflare.com -> R2
#   2. Create an API token with "Object Read & Write" permission
#   3. S3_ENDPOINT is: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public base URL to serve files from, if you've put a CDN or public bucket
# domain in front of storage. Leave blank to use presigned URLs (default,
# works out of the box, no extra setup required).
S3_PUBLIC_BASE_URL=

# --- Optional ---

# Shared secret for the weekly-backup-reminder endpoint, if you wire up an
# external cron service (e.g. cron-job.org, Railway cron, GitHub Actions) to
# call POST /api/scheduled/weekly-backup-reminder with header
# X-Cron-Secret: <this value>. Leave blank to disable the endpoint.
CRON_SECRET=

# Google Drive backup integration (optional). See googleDriveBackup.ts.
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# and set the authorized redirect URI to the same value as
# GOOGLE_DRIVE_CALLBACK_URL below.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_CALLBACK_URL=https://YOUR_DOMAIN/api/oauth/google-drive/callback

NODE_ENV=production
PORT=3000
