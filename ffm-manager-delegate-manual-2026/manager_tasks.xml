<slide id="manager_tasks">
  <background color="bg-navy"/>
  <shape id="top-line" type="line" x="60" y="92" width="1160" height="0" stroke="grid-line" stroke-width="1"/>
  <text id="section-label" x="80" y="48" width="320" height="22" font="mono" size="14" color="accent-cyan">04 / MANAGER EXECUTION</text>
  <text id="slide-title" x="80" y="118" width="980" height="52" font="heading" size="38" color="text-main">Turn plans into accountable tasks</text>
  <text id="slide-intro" x="82" y="174" width="980" height="30" font="body" size="18" color="text-muted">Every task should have one client, one assigned Delegate, one time, and one clear operational purpose.</text>
  <shape id="process-line" type="line" x="123" y="272" width="0" height="294" stroke="accent-royal" stroke-width="3"/>
  <shape id="step1" type="ellipse" x="100" y="244" width="46" height="46" fill="accent-cyan"/><text id="step1n" x="100" y="252" width="46" height="28" font="mono" size="18" color="bg-navy" align="center">1</text><text id="step1t" x="178" y="250" width="520" height="28" font="body" size="21" color="text-main">Confirm the client and its doctor data.</text>
  <shape id="step2" type="ellipse" x="100" y="304" width="46" height="46" fill="accent-cyan"/><text id="step2n" x="100" y="312" width="46" height="28" font="mono" size="18" color="bg-navy" align="center">2</text><text id="step2t" x="178" y="310" width="520" height="28" font="body" size="21" color="text-main">Choose an assigned Delegate—not an unassigned user.</text>
  <shape id="step3" type="ellipse" x="100" y="364" width="46" height="46" fill="accent-cyan"/><text id="step3n" x="100" y="372" width="46" height="28" font="mono" size="18" color="bg-navy" align="center">3</text><text id="step3t" x="178" y="370" width="520" height="28" font="body" size="21" color="text-main">Set a realistic date and time.</text>
  <shape id="step4" type="ellipse" x="100" y="424" width="46" height="46" fill="accent-cyan"/><text id="step4n" x="100" y="432" width="46" height="28" font="mono" size="18" color="bg-navy" align="center">4</text><text id="step4t" x="178" y="430" width="520" height="28" font="body" size="21" color="text-main">Create the task and monitor its status.</text>
  <shape id="step5" type="ellipse" x="100" y="484" width="46" height="46" fill="accent-cyan"/><text id="step5n" x="100" y="492" width="46" height="28" font="mono" size="18" color="bg-navy" align="center">5</text><text id="step5t" x="178" y="490" width="520" height="28" font="body" size="21" color="text-main">Review related visit-plan proposals.</text>
  <shape id="step6" type="ellipse" x="100" y="544" width="46" height="46" fill="accent-cyan"/><text id="step6n" x="100" y="552" width="46" height="28" font="mono" size="18" color="bg-navy" align="center">6</text><text id="step6t" x="178" y="550" width="520" height="28" font="body" size="21" color="text-main">Message early when timing or scope changes.</text>
  <shape id="decision-frame" type="rect" x="790" y="244" width="390" height="344" fill="none" stroke="accent-royal" stroke-width="2"/>
  <text id="decision-label" x="822" y="272" width="290" height="22" font="mono" size="14" color="accent-cyan">VISIT PLAN REVIEW</text>
  <text id="approve" x="822" y="330" width="300" height="28" font="body" size="22" color="text-main">Approve</text>
  <text id="approve-detail" x="822" y="364" width="315" height="46" font="body" size="17" color="text-muted">Use when client, purpose, route, and timing support the operational plan.</text>
  <text id="reject" x="822" y="434" width="300" height="28" font="body" size="22" color="text-main">Reject with direction</text>
  <text id="reject-detail" x="822" y="468" width="315" height="64" font="body" size="17" color="text-muted">State what must change. Ask for a corrected proposal rather than leaving an urgent plan unresolved.</text>
  <icon id="registration-icon" name="crosshair" x="1168" y="44" width="38" height="38" color="accent-cyan"/>
  <text id="slide-number" x="80" y="670" width="70" height="20" font="mono" size="14" color="accent-cyan">05</text>
</slide>
